<Window x:Class="Telhai.DotNet.PlayerProject.EditSongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Edit Song" Height="520" Width="820" WindowStartupLocation="CenterOwner"
        Background="#222" Foreground="White">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: cover + basic info -->
        <StackPanel Grid.Column="0" Margin="0,0,14,0">
            <Border CornerRadius="10" Background="#333" Padding="8">
                <Image Source="{Binding CoverImage}" Height="220" Stretch="UniformToFill"/>
            </Border>

            <TextBlock Text="Title" Margin="0,14,0,4" Foreground="#AAA"/>
            <TextBox Text="{Binding DisplayTitle, UpdateSourceTrigger=PropertyChanged}" Background="#333" Foreground="White" BorderBrush="#555"/>

            <TextBlock Text="Artist" Margin="0,12,0,2" Foreground="#AAA"/>
            <TextBlock Text="{Binding Artist}" TextWrapping="Wrap"/>

            <TextBlock Text="Album" Margin="0,12,0,2" Foreground="#AAA"/>
            <TextBlock Text="{Binding Album}" TextWrapping="Wrap"/>

            <TextBlock Text="File Path" Margin="0,12,0,2" Foreground="#AAA"/>
            <TextBlock Text="{Binding FilePath}" TextWrapping="Wrap" FontSize="11" Foreground="#CCC"/>
        </StackPanel>

        <!-- Right: images manager -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Images for this song (shown in loop during playback)" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <ListBox ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}"
                         Background="#333" Foreground="White" BorderBrush="#555" />

                <Border Grid.Column="1" Margin="12,0,0,0" CornerRadius="10" Background="#333" Padding="8">
                    <Image Stretch="Uniform" Source="{Binding SelectedImage}" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Add Images" Command="{Binding AddImageCommand}" Margin="0,0,8,0" Padding="10,6"/>
                <Button Content="Remove Selected" Command="{Binding RemoveSelectedImageCommand}" Margin="0,0,8,0" Padding="10,6"/>
                <Button Content="Save" Command="{Binding SaveCommand}" Background="#007ACC" Foreground="White" Padding="18,6"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
